# Video masters — drop originals in public/work/_raw/ to encode from.
# They must never be committed: they are huge and the web clips are derived.
# The folder itself is kept so it exists on a fresh clone.
public/work/_raw/*
!public/work/_raw/.gitkeep

# static export output (npm run export)
/out/

# Generated by scripts/build-media-manifest.mjs on every dev and build (see
# the predev/prebuild scripts). Tracking it means every machine that runs
# the site rewrites a committed file and collides on the next pull.
src/content/media.generated.ts
